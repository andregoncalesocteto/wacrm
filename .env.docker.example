# Env for the all-in-one stack (app + self-hosted Supabase):
#
#   ./docker/supabase/generate-env.sh      # writes .env.local with fresh secrets
#   docker compose -f docker-compose.yml -f docker-compose.supabase.yml \
#     --env-file .env.local up --build -d
#
# Everything here lives in one file because docker-compose.yml loads
# .env.local into the app container and the Supabase services interpolate
# from it. Variables the app never reads (POSTGRES_PASSWORD, JWT_SECRET,
# ...) are harmless but do land in the app's environment.
# See .env.local.example for the app-only variables (AI, cron, Meta ID).

# ---- Public URLs (NEXT_PUBLIC_* are inlined at build time: rebuild) ----
# Host the browser AND the app container use to reach Supabase. The
# default resolves to 127.0.0.1 on your machine via public DNS, and to
# the gateway inside the Docker network via a network alias. For a real
# deployment put TLS in front of the gateway and set the real domain
# (SUPABASE_HOST then only affects the local alias).
SUPABASE_HOST=supabase.localtest.me
SUPABASE_HTTP_PORT=8000
SUPABASE_PUBLIC_URL=http://supabase.localtest.me:8000
NEXT_PUBLIC_SUPABASE_URL=http://supabase.localtest.me:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_LOCALE=en
HOST_PORT=3000

# ---- Secrets (generate-env.sh fills these in) ----
POSTGRES_PASSWORD=
JWT_SECRET=
# HS256 JWTs signed with JWT_SECRET, roles anon / service_role.
ANON_KEY=
SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
PG_META_CRYPTO_KEY=
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
ENCRYPTION_KEY=
AUTOMATION_CRON_SECRET=
# Required by the webhook — Meta for Developers → App Settings → Basic.
META_APP_SECRET=

# ---- Auth ----
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
# true = accounts work immediately (no SMTP needed). Set false and fill
# SMTP_* to require email confirmation.
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=wacrm
ADDITIONAL_REDIRECT_URLS=
